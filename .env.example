# Get your FREE NewsAPI key at https://newsapi.org/ (100 req/day on free tier)
NEWSAPI_KEY=your_newsapi_key_here

# Tenor GIF API key (demo key works out of the box — get your own at https://developers.google.com/tenor)
TENOR_KEY=LIVDSRZULELA

# Imgflip meme generator — create free account at imgflip.com (Settings → set a password if you used Google login)
VITE_IMGFLIP_USERNAME=your_imgflip_username
VITE_IMGFLIP_PASSWORD=your_imgflip_password

# Server port (default: 3001)
PORT=3001
